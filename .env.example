# ─── Base de datos ───────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_DATABASE=your_database_name
DB_CONN_LIMIT=10

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3002
NODE_ENV=development
SESSION_SECRET=change_me_to_a_long_random_string

# ─── LDAP (Federación de Usuarios) ──────────────────────────────────────────
LDAP_HOST=localhost
LDAP_PORT=389
LDAP_ADMIN_DN=cn=admin,dc=facturacion,dc=local
LDAP_ADMIN_PASSWORD=admin123
LDAP_USERS_DN=ou=usuarios,dc=facturacion,dc=local
LDAP_DOMAIN=facturacion.local

# ─── Seguridad y CORS ────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3002

# ─── Criptografía KMS ────────────────────────────────────────────────────────
KMS_MODE=mock
KMS_MOCK_MASTER_KEY=applebox-studios-kms-master-secret-key-salt-seed

